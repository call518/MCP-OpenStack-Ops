# MCP Server Configuration Template
# Copy this file to .env and modify values as needed

# OpenWebUI global default model params (JSON), applied to every model.
# Some OpenAI reasoning models reject MCP tool calls on /v1/chat/completions
# unless reasoning_effort is "none", failing with:
#   "Function tools with reasoning_effort are not supported ..."
# Requires the OpenAI connection's API Type to be "Chat Completions". With
# "Responses", OpenWebUI 0.13.0 still sends reasoning_effort and fails with:
#   "Unsupported parameter: 'reasoning_effort' ..."
# Seeded into the OpenWebUI database on first startup only. If the
# open-webui-data volume already exists, set it in the Admin UI instead.
# Models or providers that do not support reasoning_effort may reject it;
# if so, comment this out and set Reasoning Effort per model instead.
DEFAULT_MODEL_PARAMS={"reasoning_effort":"none"}

# Stable OpenWebUI encryption/session key. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=replace_with_a_random_value

# MCPO configuration mounted by docker-compose.yml. Docker Compose automatically
# reads this .env file for ${MCPO_CONFIG_FILE}; the value below is the default.
# Keep tracked mcp-config.json.* files as reference templates. Before inserting
# credentials, copy the selected template to its ignored *.local equivalent
# (for example, mcp-config.json.multi-user.local) and select that local filename.
MCPO_CONFIG_FILE=mcp-config.json.http.local

# Logging level
MCP_LOG_LEVEL=INFO

# Safety Control - Allow OpenStack state modification operations
# Set to true to enable modification operations (create, delete, update)
# Set to false to allow only read-only operations (list, get, show)
ALLOW_MODIFY_OPERATIONS=false

# Cross-project reads - expose all_projects=true on supported list tools
# This grants no permission; OpenStack policy decides each request
ALLOW_CROSS_PROJECT_READ=false

# Python module path for Docker
PYTHONPATH=/app/src

# Transport configuration
FASTMCP_TYPE=streamable-http

# HTTP Transport settings (used only when FASTMCP_TYPE=streamable-http)
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000

# (Optional) Enable request-scoped, per-user OpenStack authentication.
# Set to true only for streamable-http clients that send both of these headers
# on every MCP request:
#   X-OpenStack-Application-Credential-ID
#   X-OpenStack-Application-Credential-Secret
# This mode requires OS_AUTH_PROTOCOL=https and OS_AUTH_HOST by default. It authenticates
# each request directly with Keystone, does not use OS_USERNAME, OS_PASSWORD,
# or OS_PROJECT_NAME, and never falls back to the server environment account.
# It can run alone or behind shared Bearer authentication. When both modes are
# enabled, Bearer is checked first and the Application Credential second.
# Leave this false for a shared Docker Compose OpenWebUI/MCPO deployment, which
# uses one fixed upstream header set. It may be true when every user has an
# independent instance whose private config contains only their own headers.
MCP_MULTI_USER=false

# Development/testing only: explicitly allow multi-user credentials over HTTP.
# Keep false in production. When true, use disposable least-privilege credentials
# on an isolated network because secrets and tokens are transmitted in plaintext.
MCP_MULTI_USER_ALLOW_INSECURE_HTTP=false

# (Optional) Enable HTTP Bearer token authentication for streamable-http mode.
# Clients must send Authorization: Bearer <REMOTE_SECRET_KEY> when enabled.
# With MCP_MULTI_USER=true, every request must pass both Bearer authentication
# and the caller's Application Credential authentication.
# When enabled, use a strong, unique REMOTE_SECRET_KEY.
REMOTE_AUTH_ENABLE=false
REMOTE_SECRET_KEY=

# OpenStack API environment variables
# Single-account mode uses the domain, project, username, and password below.
# Multi-user mode ignores those account values and derives the caller's user,
# project, and delegated roles from the Application Credential on each request.
OS_PROJECT_DOMAIN_NAME=Default
OS_USER_DOMAIN_NAME=Default

# Single-account mode scopes operations to this configured project.
# For multiple single-account projects, deploy separate MCP server instances.
OS_PROJECT_NAME=your_project_name
OS_TENANT_NAME=your_tenant_name
OS_USERNAME=your_username
OS_PASSWORD=your_password
OS_AUTH_HOST=your-openstack-host
OS_INTERFACE=internal
OS_ENDPOINT_TYPE=internalURL
OS_IDENTITY_API_VERSION=3
OS_REGION_NAME=RegionOne
OS_AUTH_PLUGIN=password

# OpenStack Connection Protocol (http or https)
# Use 'https' for production environments with SSL/TLS enabled
# When using https, set OS_CACERT to your CA certificate path
# If OS_CACERT is not set with https, SSL verification will be disabled (insecure)
OS_AUTH_PROTOCOL=http

# (Optional) SSL CA Certificate for HTTPS connections
# Required for secure HTTPS connections to OpenStack API
# Example: OS_CACERT=/etc/ssl/certs/openstack-ca.pem
# OS_CACERT=

# OpenStack Service Port Configuration
# These ports can be customized to match your OpenStack deployment
OS_AUTH_PORT=5000
OS_COMPUTE_PORT=8774
OS_NETWORK_PORT=9696
OS_VOLUME_PORT=8776
OS_IMAGE_PORT=9292
OS_PLACEMENT_PORT=8780
OS_HEAT_STACK_PORT=8004
OS_HEAT_STACK_CFN_PORT=8000

# Docker Port Mappings
# Keep 127.0.0.1 while both HTTP authentication modes are disabled.
DOCKER_BIND_ADDRESS=127.0.0.1
DOCKER_EXTERNAL_PORT_OPENWEBUI=3000
DOCKER_EXTERNAL_PORT_MCP_SERVER=8000
DOCKER_EXTERNAL_PORT_MCPO_PROXY=8080
